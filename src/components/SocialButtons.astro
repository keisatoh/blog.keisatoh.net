---

export type Props = {
  title: string;
};

const { title } = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const shareLink = new URL('https://twitter.com/intent/tweet');
shareLink.searchParams.set('text', title);
shareLink.searchParams.set('url', shareUrl.toString());
---

<div class="flex items-center justify-center gap-3">
  <a
    class="inline-block rounded-lg border border-slate-400 bg-white px-5 py-1 text-center text-xs font-medium text-gray-900 outline-none ring-slate-400 transition duration-200 hover:bg-gray-100 hover:text-indigo-700 focus-visible:ring-2 active:bg-gray-200 sm:text-sm"
    href={shareLink}
    target="_blank"
    rel="noopener noreferrer"
    >Xでシェア</a
  >
  <a
    href="https://www.buymeacoffee.com/keisatoh"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-block rounded-lg border border-yellow-500 bg-yellow-300 px-5 py-1 text-center text-xs font-medium text-gray-900 outline-none ring-yellow-600 transition duration-200 hover:bg-yellow-200 focus-visible:ring-2 active:bg-yellow-400 sm:text-sm"
    >Buy Me a Coffee</a
  >
</div>
