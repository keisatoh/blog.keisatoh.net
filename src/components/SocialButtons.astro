---

export type Props = {
  title: string;
};

const { title } = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<div class="flex items-center justify-center gap-3">
  <button
    type="button"
    class="inline-flex h-8 cursor-pointer items-center rounded-full bg-black px-4 py-1 text-xs font-normal leading-none !text-white outline-none transition-colors hover:bg-slate-800 focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 active:bg-slate-900"
    data-x-post
    data-title={title}
    data-url={shareUrl.toString()}
    aria-label="Xでポスト"
  >
    <span>Xでポスト</span>
  </button>
  <a
    href="https://www.buymeacoffee.com/keisatoh"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Buy Me a Coffee"
    >
    <img
      src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png"
      alt="Buy Me a Coffee"
      class="!my-0 h-9"
    />
  </a>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-x-post]').forEach((button) => {
    button.addEventListener('click', () => {
      // Keep the X URL out of the initial markup so content blockers do not
      // mistake this first-party button for an embedded social widget.
      const host = ['x', 'com'].join('.');
      const postUrl = new URL(`https://${host}/intent/tweet`);
      postUrl.searchParams.set('text', button.dataset.title ?? '');
      postUrl.searchParams.set('url', button.dataset.url ?? window.location.href);
      window.open(postUrl, '_blank', 'noopener,noreferrer');
    });
  });
</script>
