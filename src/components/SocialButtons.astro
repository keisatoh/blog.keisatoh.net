---

export type Props = {
  title: string;
};

const { title } = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const shareLink = new URL('https://x.com/intent/tweet');
shareLink.searchParams.set('text', title);
shareLink.searchParams.set('url', shareUrl.toString());
---

<div class="flex items-center justify-center gap-3">
  <a
    class="no-underline inline-flex h-8 items-center gap-1.5 rounded-full bg-black px-4 py-1 text-xs font-semibold leading-none text-white outline-none transition-colors hover:bg-slate-800 hover:no-underline focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 active:bg-slate-900"
    href={shareLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Xでポスト"
    >
    <svg
      aria-hidden="true"
      class="h-3.5 w-3.5 shrink-0 fill-current"
      viewBox="0 0 1200 1227"
    >
      <path
        d="M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37H105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM569.165 687.828L521.697 619.934L144.011 79.6944H306.615L611.412 515.685L658.88 583.579L1055.08 1150.3H892.476L569.165 687.854V687.828Z"
      />
    </svg>
    <span>ポスト</span>
  </a>
  <a
    href="https://www.buymeacoffee.com/keisatoh"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Buy Me a Coffee"
    >
    <img
      src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png"
      alt="Buy Me a Coffee"
      class="!my-0 h-9"
    />
  </a>
</div>
