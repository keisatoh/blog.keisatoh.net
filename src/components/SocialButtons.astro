---

export type Props = {
  title: string;
};

const { title } = Astro.props;
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const shareLink = new URL('https://x.com/intent/tweet');
shareLink.searchParams.set('text', title);
shareLink.searchParams.set('url', shareUrl.toString());
---

<div class="flex items-center justify-center gap-3">
  <a
    class="no-underline inline-flex h-8 items-center rounded-full bg-black px-4 py-1 text-xs font-normal leading-none !text-white outline-none transition-colors hover:bg-slate-800 hover:no-underline focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 active:bg-slate-900"
    href={shareLink}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Xでポスト"
    >
    <span>Xでポスト</span>
  </a>
  <a
    href="https://www.buymeacoffee.com/keisatoh"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Buy Me a Coffee"
    >
    <img
      src="https://cdn.buymeacoffee.com/buttons/v2/default-yellow.png"
      alt="Buy Me a Coffee"
      class="!my-0 h-9"
    />
  </a>
</div>
